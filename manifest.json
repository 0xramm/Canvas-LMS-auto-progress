{
  "manifest_version": 3,
  "name": "Canvas LMS Auto Progress",
  "version": "1.1",
  "description": "Course progress dashboard for lms.vitonline.in",
  "permissions": ["cookies", "storage"],
  "host_permissions": ["https://lms.vitonline.in/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "48": "icon.png" }
  },
  "background": {
    "service_worker": "background.js"
  }
}
